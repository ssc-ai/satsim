{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ssc-ai.github.io/satsim/schema/v1/Geometry.json",
    "title": "Geometry",
    "description": "Describes the scene geometry.",
    "type": "object",
    "properties": {
        "time": {
            "description": "Start time of simulation and exposure.",
            "$ref": "types/Time.json"
        },
        "site": {
            "description": "The observing site. Passive RF may use an array of sites.",
            "oneOf": [
                { "$ref": "types/Site.json" },
                {
                    "type": "array",
                    "minItems": 2,
                    "items": { "$ref": "types/Site.json" }
                }
            ]
        },
        "stars": {
            "properties": {
                "mode": {
                    "description": "The star mode.",
                    "type": "string",
                    "enum": ["sstr7", "csv", "bins", "none"]
                },
                "path": {
                    "description": "The path to the star catalog is `mode` is `sstr7` or `csv`.",
                    "type": "string"
                },
                "gcvs5": {
                    "description": "GCVS5 variability augmentation settings (only used with `mode` = `sstr7`).",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Enable variability augmentation using GCVS5.",
                            "type": "boolean",
                            "default": false
                        },
                        "path": {
                            "description": "Path to `gcvs5.txt`.",
                            "type": "string"
                        },
                        "match_radius_arcsec": {
                            "description": "Cone search radius for GCVS matches, in arcseconds.",
                            "$ref": "types/Float.json",
                            "default": 5.0
                        },
                        "template": {
                            "description": "Light curve template selection.",
                            "type": "string",
                            "enum": ["auto", "sin", "saw", "eclipse"],
                            "default": "auto"
                        },
                        "missing_period_mode": {
                            "description": "Behavior when period is missing.",
                            "type": "string",
                            "enum": ["constant", "random"],
                            "default": "constant"
                        },
                        "missing_period_seed": {
                            "description": "Seed for deterministic missing-period sampling.",
                            "type": "integer"
                        },
                        "mag_system": {
                            "description": "Filter by a single magnitude system (e.g., \"V\").",
                            "type": "string"
                        },
                        "mag_systems": {
                            "description": "Filter by a list of magnitude systems (e.g., [\"V\", \"Hp\"]).",
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "motion": {
                    "description": "Injects artificial star motion.",
                    "properties": {
                        "mode": {
                            "description": "The star motion mode. If `none`, use site geometry",
                            "type": "string",
                            "enum": ["affine", "affine-polar", "none"]
                        },
                        "rotation": {
                            "description": "The star rotation in degrees from center of image.",
                            "$ref": "types/Float.json"
                        },
                        "translation": {
                            "description": "The star translation in pix/sec x and y in the FPA of mode is `affine`, or in degrees theta and pix/sec magnitude if mode is `affine-polar`.",
                            "type": "array",
                            "items": {
                                "$ref": "types/Float.json"
                            }
                        }
                    }
                },
                "mv": {
                    "description": "The star brightness density bins if mode is `bins`.",
                    "properties": {
                        "bins": {
                            "description": "The star brightness density bin boundaries.",
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "density": {
                            "description": "The star brightness density for each bin.",
                            "$ref": "types/Array.json"
                        }
                    }
                }
            },
            "required": ["mode"],
            "examples": [
                {
                    "mode": "sstr7",
                    "path": "/workspace/share/sstrc7",
                    "motion": { "mode": "none" }
                },
                {
                    "mode": "bins",
                    "mv": {
                        "$import": "../common/sky_density_bins.json"
                    },
                    "motion": {
                        "mode": "affine-polar",
                        "rotation":
                            { "$sample": "random.uniform", "low": -0.001, "high": 0.001 },
                        "translation": [
                            { "$sample": "random.uniform", "low": 0, "high": 360 },
                            { "$sample": "random.uniform", "low": 5.0, "high": 15.0 }
                        ]
                    }
                }
            ]
        },
        "obs": {
            "oneOf": [
                { "$ref": "generators/Generator.json" },
                {
                    "title": "List",
                    "properties": {
                        "mode": {
                            "description": "The obs simulation mode.",
                            "type": "string",
                            "enum": ["list"]
                        },
                        "list": {
                            "type": ["array", "object"],
                            "items": {
                                "anyOf": [
                                    { "$ref": "types/Line.json" },
                                    { "$ref": "types/LinePolar.json" },
                                    { "$ref": "types/Tle.json" },
                                    { "$ref": "types/StateVector.json" },
                                    { "$ref": "types/GreatCircle.json" },
                                    { "$ref": "types/Observation.json" },
                                    { "$ref": "types/Ephemeris.json" }
                                ]
                            }
                        }
                    },
                    "required": ["mode", "list"]
                }
            ]
        }
    },
    "required": ["obs"]
}
